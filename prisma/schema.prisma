// KayEdu — Prisma schema (Phase 1)
// Money is stored as INTEGER piastres (EGP * 100). Never use floats for money.
// Every tenant-scoped model carries centerId and indexes it.
// Read /docs/01-data-model.md before editing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Supabase pooler vs direct connection for migrations
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum Role {
  OWNER
  MANAGER
  RECEPTIONIST
  ACCOUNTANT
  TEACHER
}

enum ShareType {
  FIXED // centerShareValue is piastres taken by the center
  PERCENTAGE // centerShareValue is a whole-number percent (e.g. 15)
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum PaymentMethod {
  CASH
  INSTAPAY
  WALLET
  VISA
}

enum SessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  REMOVED
  BLOCKED
}

enum BlockScope {
  TEACHER
  CLASS
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum ChangeRequestType {
  NEW_CLASS
  NEW_SESSION
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum ConflictPolicy {
  WARN // save/generate anyway; surface the conflict in the UI
  DENY // refuse the conflicting slot/session
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// The kind a CenterCatalogSelection/CatalogSuggestion targets (M13). One
// discriminator shared by both — a suggestion resolves into exactly the kind
// of canonical row a selection of the same kind points at.
enum CatalogEntryKind {
  EDUCATION_SYSTEM
  GRADE
  SUBJECT
}

enum CatalogSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// A teacher payout's lifecycle (M14, spec §5 "Teacher settlements"). No
// partially-paid state — a settlement is fully paid or it is not.
enum SettlementStatus {
  DRAFT
  APPROVED
  PAID
}

// ─────────────────────────────────────────────────────────────
// IDENTITY (global — no centerId)
// ─────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  // Links to Supabase auth.users.id; kept as the app-side profile.
  authId          String?  @unique
  firstName       String
  lastName        String
  email           String?  @unique
  phone           String?  @unique
  altPhone        String?
  avatarUrl       String?
  locale          String   @default("ar") // "ar" | "en"
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     Membership[]
  studentProfiles StudentProfile[]
  taughtClasses   ClassGroup[]     @relation("ClassTeacher")
  taughtSessions  Session[]        @relation("SessionTeacher")
  reservations    Reservation[]
  auditLogs       AuditLog[]
  // M14 — this user's own payout history, as a TEACHER. Named distinctly
  // from `taughtSessions`/`taughtClasses` since a Settlement references the
  // teacher, not a class or session.
  settlements     Settlement[]     @relation("SettlementTeacher")
}

// ─────────────────────────────────────────────────────────────
// ORGANIZATION (M11)
// ─────────────────────────────────────────────────────────────

/**
 * The paying customer (docs/00-master-product-spec.md §5.1 "Branch
 * architecture"). Global — no `centerId`, isolates nothing, and is
 * deliberately not a tenant. In the UI this reads as "Center"; the DB name
 * and the screen label differ on purpose (docs/02-architecture.md §8).
 */
model Organization {
  id        String   @id @default(uuid())
  name      String
  nameEn    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  centers Center[]
}

model Center {
  id             String       @id @default(uuid())
  slug           String       @unique // subdomain / branding key
  name           String
  nameEn         String?
  logoUrl        String?
  themeColor     String       @default("#2563EB")
  active         Boolean      @default(true)
  plan           String? // onboarding/plan metadata
  // The organization (paying customer) this branch belongs to (M11). The
  // tenant, and the sole isolation key, stays Center/centerId — this is an
  // additive parent, not a rewrite of scoping (docs/01-data-model.md §4).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  settings           CenterSettings?
  memberships        Membership[]
  invitations        Invitation[]
  catalogSelections  CenterCatalogSelection[]
  catalogSuggestions CatalogSuggestion[]
  rooms              Room[]
  classGroups        ClassGroup[]
  studentProfiles    StudentProfile[]
  enrollments        Enrollment[]
  sessions           Session[]
  attendees          SessionAttendee[]
  payments           Payment[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  reservations       Reservation[]
  changeRequests     ChangeRequest[]
  studentBlocks      StudentBlock[]
  holidays           Holiday[]
  auditLogs          AuditLog[]
  permissionGrants   PermissionGrant[]
  branchGrants       MembershipBranchGrant[]  @relation("MembershipBranchGrantCenter")
  refunds            Refund[]
  settlements        Settlement[]

  @@index([organizationId])
}

model CenterSettings {
  id                       String         @id @default(uuid())
  centerId                 String         @unique
  center                   Center         @relation(fields: [centerId], references: [id], onDelete: Cascade)
  defaultShareType         ShareType      @default(PERCENTAGE)
  defaultShareValue        Int            @default(15) // percent OR piastres per defaultShareType
  teacherTimeoutDays       Int? // null = disabled
  defaultLateThreshold     Int            @default(10) // minutes
  cardLayout               Json? // ID-card customization (positions of name/id/logo…)
  timezone                 String         @default("Africa/Cairo")
  // Teacher/room double-booking (docs/02-architecture.md §11): WARN saves the
  // conflicting slot/session and surfaces it in the UI; DENY refuses it.
  scheduleConflictPolicy   ConflictPolicy @default(WARN)
  // A teacher's deadline to edit their own session description, in hours
  // after the session date (M10, closing the gap flagged at M5/M7). Null =
  // no deadline, editable any time — the M7 default.
  teacherEditDeadlineHours Int?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
}

model Membership {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  centerId         String
  center           Center    @relation(fields: [centerId], references: [id], onDelete: Cascade)
  role             Role
  active           Boolean   @default(true)
  // Center-local record for this person (docs/01-data-model.md §6). Identity
  // stays global on User (the auth credential + the platform-wide default),
  // but name and contact are what *this* center has on file — seeded from
  // User at creation, then editable here independently of what any other
  // center stores, and never written back to User.
  firstName        String?
  lastName         String?
  email            String?
  phone            String?
  altPhone         String?
  // Teacher-only (M10): gates the "request a new class/session" forms
  // (spec §4.2 items 2 & 4 say "a trusted teacher"). Defaults true so the
  // M7/M9 behavior ("every active TEACHER membership is trusted") is
  // unchanged until a manager deliberately revokes trust for one teacher.
  isTrustedTeacher Boolean   @default(true)
  invitedAt        DateTime  @default(now())
  joinedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  branchGrants MembershipBranchGrant[]

  @@unique([userId, centerId, role])
  @@index([centerId])
  @@index([centerId, role])
  @@index([userId])
}

model Invitation {
  id        String           @id @default(uuid())
  centerId  String
  center    Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  email     String
  role      Role
  token     String           @unique
  status    InvitationStatus @default(PENDING)
  invitedBy String
  expiresAt DateTime
  createdAt DateTime         @default(now())

  @@index([centerId])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────
// PERMISSIONS (M12)
// ─────────────────────────────────────────────────────────────

/**
 * The stored, action-level permission matrix (docs/02-architecture.md §6.1)
 * that replaces the hardcoded role→permission map and the two
 * `CenterSettings` booleans it grew out of. `action` is a `Permission` union
 * member (`lib/auth/permissions.ts`) stored as a plain string so a new action
 * needs no migration to become grantable.
 * Deny by default: an action with no row here is denied to that role,
 * including a brand-new action nobody has granted yet. A hardcoded ceiling
 * (`lib/auth/permissions.ts`) still overrides this table both ways — an
 * OWNER's ownership actions are always true regardless of rows here, and a
 * few actions (e.g. a TEACHER holding `center.profit.view`) can never be
 * granted no matter what row exists — so a bad or malicious row can never
 * itself create a privilege escalation. Only OWNER may write these rows
 * (`lib/db/permissions.ts`), and every write is audited.
 */
model PermissionGrant {
  id        String   @id @default(uuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  role      Role
  action    String
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([centerId, role, action])
  @@index([centerId])
}

/**
 * An Owner-granted widening of a branch-scoped membership's reach to an
 * additional branch (docs/01-data-model.md "Organization layer"). Only
 * MANAGER/RECEPTIONIST/ACCOUNTANT memberships are ever widened this way: an
 * OWNER already resolves every branch under their organization
 * (`getUserCenterRelations()`), and a TEACHER's multi-center reach is a
 * second real `Membership` row at that center, not a widening of one.
 * Resolution is additive and never subtractive — a grant can never remove
 * the membership's own home branch. Only OWNER may write one, and every
 * write is audited (`membership.branch.grant` / `membership.branch.revoke`).
 */
model MembershipBranchGrant {
  id           String     @id @default(uuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  centerId     String
  center       Center     @relation("MembershipBranchGrantCenter", fields: [centerId], references: [id], onDelete: Cascade)
  grantedBy    String
  createdAt    DateTime   @default(now())

  @@unique([membershipId, centerId])
  @@index([membershipId])
  @@index([centerId])
}

// ─────────────────────────────────────────────────────────────
// ACADEMIC CATALOG (M13 — GLOBAL, no centerId; docs/01-data-model.md
// "Academic catalog layer"). Education systems, grades and subjects are
// platform-owned reference data. A centre no longer authors these rows — it
// picks one via CenterCatalogSelection, and may propose a new or corrected
// entry via CatalogSuggestion for a platform admin to resolve. Every entry
// carries both an Arabic and an English name; a centre's own display-name/
// price choices live only on its CenterCatalogSelection row, never here.
// ─────────────────────────────────────────────────────────────

model CatalogEducationSystem {
  id                      String   @id @default(uuid())
  nameAr                  String
  nameEn                  String
  // The default FIXED-cut piastre amount a class inherits when its
  // centerShareType is set to FIXED (CLAUDE.md rule 3, spec §5.1 "Center
  // cut") — e.g. American 40 EGP, IGCSE 50 EGP. Configuration-time only:
  // never read at payment time, so changing it moves zero existing classes
  // and zero recorded payments.
  defaultFixedCenterShare Int      @default(0)
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  grades      CatalogGrade[]
  selections  CenterCatalogSelection[]
  classGroups ClassGroup[]
}

model CatalogGrade {
  id                String                  @id @default(uuid())
  nameAr            String
  nameEn            String
  educationSystemId String?
  educationSystem   CatalogEducationSystem? @relation(fields: [educationSystemId], references: [id])
  active            Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  subjects        CatalogSubject[]
  selections      CenterCatalogSelection[]
  classGroups     ClassGroup[]
  studentProfiles StudentProfile[]

  @@index([educationSystemId])
}

model CatalogSubject {
  id        String        @id @default(uuid())
  nameAr    String
  nameEn    String
  gradeId   String?
  grade     CatalogGrade? @relation(fields: [gradeId], references: [id])
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  selections  CenterCatalogSelection[]
  classGroups ClassGroup[]

  @@index([gradeId])
}

/**
 * A centre's pick of one global catalog entry, and the *only* place a centre
 * may record its own opinion about that entry: a display-name override and
 * (for an education system) a base price. `kind` says which of the three
 * nullable FKs is populated; the other two stay null for that row. Enforced
 * in the application layer (`lib/db/catalog.ts`), the same "app-layer
 * invariant over a DB constraint" shape `StudentBlock.refId` already uses in
 * this schema — a `kind` mismatch would need a cross-column CHECK constraint
 * Prisma migrations don't express, and the app never writes one.
 */
model CenterCatalogSelection {
  id       String           @id @default(uuid())
  centerId String
  center   Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  kind     CatalogEntryKind

  educationSystemId String?
  educationSystem   CatalogEducationSystem? @relation(fields: [educationSystemId], references: [id], onDelete: Cascade)
  gradeId           String?
  grade             CatalogGrade?           @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subjectId         String?
  subject           CatalogSubject?         @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // The two things a centre may edit about a picked entry — never the
  // canonical row itself (CLAUDE.md M13 brief). Null displayName = render the
  // catalog entry's own bilingual name. basePrice is only meaningful for
  // kind = EDUCATION_SYSTEM; null elsewhere.
  displayName String?
  basePrice   Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([centerId, kind, educationSystemId])
  @@unique([centerId, kind, gradeId])
  @@unique([centerId, kind, subjectId])
  @@index([centerId])
  @@index([educationSystemId])
  @@index([gradeId])
  @@index([subjectId])
}

/**
 * A centre-submitted proposal — a brand-new entry or a correction to an
 * existing one — queued for platform-admin review (`00-master-product-spec.md`
 * §4.4). `targetId`/`parentId` are plain unenforced references (like
 * `AuditLog.entityId`/`StudentBlock.refId`) rather than three sets of
 * optional relations, because which table they point into varies with
 * `kind`: `targetId` names the existing catalog row being corrected (null =
 * propose a new entry), `parentId` names the new row's parent when proposing
 * a new GRADE (an education-system id) or SUBJECT (a grade id).
 */
model CatalogSuggestion {
  id       String           @id @default(uuid())
  centerId String
  center   Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  kind     CatalogEntryKind

  targetId String?
  parentId String?

  proposedNameAr String
  proposedNameEn String
  note           String?

  status     CatalogSuggestionStatus @default(PENDING)
  resolvedBy String?
  resolvedAt DateTime?
  createdBy  String
  createdAt  DateTime                @default(now())

  @@index([centerId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// ACADEMIC / CONFIG (centerId-scoped)
// ─────────────────────────────────────────────────────────────

model Room {
  id        String   @id @default(uuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classGroups ClassGroup[]
  sessions    Session[]

  @@index([centerId])
}

model ClassGroup {
  id                   String                  @id @default(uuid())
  centerId             String
  center               Center                  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  teacherId            String
  teacher              User                    @relation("ClassTeacher", fields: [teacherId], references: [id])
  // Catalog references (M13) — global entries, resolved through the centre's
  // own CenterCatalogSelection for display name and price
  // (docs/01-data-model.md "Config layer"). Never a direct centre-authored
  // row anymore.
  subjectId            String?
  subject              CatalogSubject?         @relation(fields: [subjectId], references: [id])
  gradeId              String?
  grade                CatalogGrade?           @relation(fields: [gradeId], references: [id])
  educationSystemId    String?
  educationSystem      CatalogEducationSystem? @relation(fields: [educationSystemId], references: [id])
  roomId               String?
  room                 Room?                   @relation(fields: [roomId], references: [id])
  price                Int                     @default(0) // piastres per session
  // Center's cut config — resolved onto payments as a snapshot.
  centerShareType      ShareType               @default(PERCENTAGE)
  centerShareValue     Int                     @default(15) // percent OR piastres
  capacity             Int                     @default(0)
  attendanceRequired   Boolean                 @default(true)
  lateThresholdMinutes Int                     @default(10)
  acceptsNewStudents   Boolean                 @default(true)
  requiresConfirmation Boolean                 @default(false)
  // Whether EXCUSED is offered as an attendance status on this class's
  // sessions (M10, closing the gap flagged at M5 — spec §5 "Excused
  // configurable per class"). Defaults true, matching the M5 behavior where
  // all four statuses were offered on every class.
  allowExcused         Boolean                 @default(true)
  active               Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  schedules    ClassSchedule[]
  sessions     Session[]
  enrollments  Enrollment[]
  reservations Reservation[]

  @@index([centerId])
  @@index([centerId, teacherId])
}

model ClassSchedule {
  id           String     @id @default(uuid())
  centerId     String
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  dayOfWeek    Int // 0=Sunday … 6=Saturday
  startTime    String // "16:00"
  endTime      String // "18:00"
  createdAt    DateTime   @default(now())

  @@index([centerId])
  @@index([classGroupId])
}

// ─────────────────────────────────────────────────────────────
// PEOPLE IN CENTER
// ─────────────────────────────────────────────────────────────

model StudentProfile {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  centerId        String
  center          Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  studentCode     String // system-assigned per center via StudentCodeCounter — never typed
  gradeId         String?
  grade           CatalogGrade? @relation(fields: [gradeId], references: [id])
  // Center-local record for the student themselves — see the note on
  // Membership above. `User` stays the auth credential + platform default;
  // these are this center's own name/contact and never write back to it.
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  altPhone        String?
  parentFirstName String?
  parentLastName  String?
  parentPhone     String?
  parentAltPhone  String?
  // Center-uploaded student photo (Storage `avatars/{centerId}/…`). It lives
  // here, not on User.avatarUrl, because the photo a center takes for its own
  // ID card is that center's data — see docs/01-data-model.md §2.
  photoUrl        String?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  enrollments Enrollment[]
  attendees   SessionAttendee[]
  payments    Payment[]

  @@unique([userId, centerId])
  @@unique([centerId, studentCode])
  @@index([centerId])
  @@index([centerId, active])
}

/**
 * A race-free per-center sequence for `StudentProfile.studentCode`
 * (docs/01-data-model.md §6). One row per center; `next` is the code that
 * will be handed out next. Claimed with a single atomic
 * `INSERT … ON CONFLICT DO UPDATE … RETURNING` inside the same transaction
 * that creates the `StudentProfile` — see `lib/db/students.ts`.
 */
model StudentCodeCounter {
  centerId String @id
  next     Int    @default(1001)
}

model Enrollment {
  id               String           @id @default(uuid())
  centerId         String
  center           Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  studentProfileId String
  studentProfile   StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  classGroupId     String
  classGroup       ClassGroup       @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  status           EnrollmentStatus @default(ACTIVE)
  enrolledAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  attendees SessionAttendee[]

  @@unique([studentProfileId, classGroupId])
  @@index([centerId])
  @@index([classGroupId])
}

model StudentBlock {
  id            String     @id @default(uuid())
  centerId      String
  center        Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  scope         BlockScope
  refId         String // teacherId (User) or classGroupId depending on scope
  blockedUserId String
  reason        String?
  createdAt     DateTime   @default(now())

  // A student is blocked from a teacher/class once — blocking twice is a bug,
  // and "is this student blocked here?" is a hot lookup on (scope, refId).
  @@unique([centerId, scope, refId, blockedUserId])
  @@index([centerId])
  @@index([centerId, blockedUserId])
  @@index([centerId, scope, refId])
}

// ─────────────────────────────────────────────────────────────
// SESSIONS & ATTENDANCE
// ─────────────────────────────────────────────────────────────

model Session {
  id               String        @id @default(uuid())
  centerId         String
  center           Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  classGroupId     String
  classGroup       ClassGroup    @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacherId        String
  teacher          User          @relation("SessionTeacher", fields: [teacherId], references: [id])
  roomId           String?
  room             Room?         @relation(fields: [roomId], references: [id])
  date             DateTime // the calendar day of the session
  startTime        String // "16:00"
  endTime          String // "18:00"
  status           SessionStatus @default(SCHEDULED)
  priceSnapshot    Int           @default(0) // piastres; frozen from class at generation
  // Per-session centre-cut override (M13, spec §5.1 "Center cut" —
  // "overridable per class and per session"). Null on both = inherit the
  // class's own centerShareType/centerShareValue, which is every session's
  // state until someone explicitly overrides this one. Consulted only by
  // `recordPayment` at the moment a payment is frozen (CLAUDE.md rule 2) —
  // never rewrites an already-recorded payment's snapshots.
  centerShareType  ShareType?
  centerShareValue Int?
  description      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  attendees   SessionAttendee[]
  payments    Payment[]
  settlements Settlement[]

  // The idempotency key the session generator relies on (docs/02 §11):
  // regenerating a window is a `createMany({ skipDuplicates: true })` against
  // this constraint, so a class's own slot is never duplicated across runs.
  @@unique([classGroupId, date, startTime])
  @@index([centerId])
  @@index([centerId, date])
  @@index([centerId, teacherId, date])
  @@index([centerId, roomId, date])
}

model SessionAttendee {
  id               String           @id @default(uuid())
  centerId         String
  center           Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  sessionId        String
  session          Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentProfileId String?
  studentProfile   StudentProfile?  @relation(fields: [studentProfileId], references: [id])
  enrollmentId     String?
  enrollment       Enrollment?      @relation(fields: [enrollmentId], references: [id])
  attendanceStatus AttendanceStatus @default(PRESENT)
  isDropIn         Boolean          @default(false)
  recordedBy       String
  recordedAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // A history, not a slot: a voided payment is never deleted, so a corrected
  // re-payment for the same roster row needs a second Payment row here — see
  // the note on Payment.sessionAttendeeId below (docs/01-data-model.md §3).
  payments Payment[]

  @@unique([sessionId, studentProfileId])
  @@index([centerId])
  @@index([sessionId])
}

// The financial ledger. Money fields are FROZEN at record time. Never recompute.
model Payment {
  id                   String          @id @default(uuid())
  centerId             String
  center               Center          @relation(fields: [centerId], references: [id], onDelete: Cascade)
  sessionId            String
  session              Session         @relation(fields: [sessionId], references: [id])
  // Denormalized from session.teacherId at record time (M6, docs/02 §14): the
  // by-teacher analytics breakdown needs a single-table `groupBy`, and Prisma
  // cannot `groupBy` on a related model's scalar column. Not a money field —
  // just a reference snapshot, like `recordedBy` — so it carries none of the
  // "never recompute" weight CLAUDE.md rule 2 puts on the share snapshots.
  teacherId            String
  // Deliberately NOT @unique (revised at M5): a void never deletes its row
  // (CLAUDE.md rule 2), and a correction writes a *new* Payment for the same
  // roster row rather than reusing or replacing the voided one — so one
  // SessionAttendee can carry more than one Payment over its history, with
  // the application layer (lib/db/payments.ts `recordPayment`) enforcing "at
  // most one non-voided Payment per attendee at a time" instead of the
  // database. See docs/01-data-model.md §3.
  sessionAttendeeId    String
  sessionAttendee      SessionAttendee @relation(fields: [sessionAttendeeId], references: [id], onDelete: Cascade)
  studentProfileId     String
  studentProfile       StudentProfile  @relation(fields: [studentProfileId], references: [id])
  amount               Int // piastres collected
  method               PaymentMethod   @default(CASH)
  priceSnapshot        Int // frozen
  centerShareSnapshot  Int // frozen
  teacherShareSnapshot Int // frozen
  receiptRef           String?
  voided               Boolean         @default(false)
  voidReason           String?
  voidedAt             DateTime?
  voidedBy             String?
  // M14 — a plain marker so a reader sees the refunded state without a join;
  // the actual reversal amounts live on the `Refund` row, never here. A
  // voided payment is never refunded and vice versa (CLAUDE.md rule 7: void
  // and refund are different mechanisms, never collapsed into one flag).
  refunded             Boolean         @default(false)
  refund               Refund?
  recordedBy           String
  recordedAt           DateTime        @default(now())
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([sessionAttendeeId])
  @@index([centerId])
  @@index([centerId, recordedAt])
  @@index([centerId, teacherId, recordedAt])
}

/**
 * Money given back, in cash — never a balance (M14, spec §5 "Void vs.
 * refund", docs/01-data-model.md "Finance-adjacent layer"). The `Payment`
 * row it reverses is preserved byte-for-byte; this row is the only place a
 * refund's amounts are recorded. Phase 1 refunds are whole-payment only —
 * there is no partial-refund UI or schema support, matching "mark a
 * recorded payment REFUNDED" (spec §4.1 item 12) rather than inventing a
 * proration model nothing asked for. `amount`/`centerShareReversed`/
 * `teacherShareReversed` are therefore always exactly the original payment's
 * own `amount`/`centerShareSnapshot`/`teacherShareSnapshot` — stored here
 * (not re-read from `Payment` on every analytics query) so the by-teacher
 * breakdown can `groupBy` on `teacherId` in one query, the same reason
 * `Payment.teacherId` itself is denormalized.
 */
model Refund {
  id        String   @id @default(uuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  paymentId String   @unique
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  // Denormalized from payment.teacherId, purely so revenueByTeacher can
  // groupBy in one query — not a money field, like Payment.teacherId itself.
  teacherId String

  amount               Int // piastres reversed — always payment.amount (whole-payment refund)
  centerShareReversed  Int // piastres reversed from the centre's share
  teacherShareReversed Int // piastres reversed from the teacher's share

  reason     String
  refundedBy String
  refundedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([centerId])
  @@index([centerId, teacherId])
}

/**
 * A teacher's payout record (M14, spec §5 "Teacher settlements"). Exactly
 * one of `sessionId` (a single session's teacher share, for a centre that
 * pays cash right after each session) or `periodFrom`+`periodTo` (a date-
 * range roll-up) is set on any row — an application-layer invariant, the
 * same "kind says which fields apply" shape `CenterCatalogSelection.kind`
 * already uses in this schema, enforced in `lib/db/settlements.ts`.
 *
 * `totalAmount` is computed ONCE, at DRAFT creation, as the sum of frozen
 * `Payment.teacherShareSnapshot` values in scope (excluding voided and
 * already-refunded payments), and never recomputed against the *class's*
 * config — a later cut change moves nothing here. A later *refund*, though,
 * is a real event that reverses money still sitting in this record, and is
 * handled differently depending on status (M14 follow-up, 00-master-
 * product-spec.md §5 "Teacher settlements"): while this settlement is
 * DRAFT or APPROVED — the payout has not left the centre yet —
 * `lib/db/refunds.ts`'s `refundPayment` finds it and subtracts the refunded
 * payment's `teacherShareReversed` from `totalAmount` in the same
 * transaction, audited as `settlement.adjust`. Once **PAID**, this row is
 * genuinely immutable — the money is already out the door, so a refund on a
 * payment inside a paid settlement's scope is never applied here; it is a
 * loss the centre absorbs or recovers directly with the teacher, and any
 * accounting for it happens outside this record, exactly as spec §5's
 * void/refund table already says for a PAID settlement.
 */
model Settlement {
  id       String @id @default(uuid())
  centerId String
  center   Center @relation(fields: [centerId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("SettlementTeacher", fields: [teacherId], references: [id])

  // Scope — exactly one of these two shapes is populated.
  sessionId  String?
  session    Session?  @relation(fields: [sessionId], references: [id])
  periodFrom DateTime?
  periodTo   DateTime?

  totalAmount Int
  status      SettlementStatus @default(DRAFT)

  createdBy  String
  createdAt  DateTime         @default(now())
  approvedBy String?
  approvedAt DateTime?
  paidBy     String?
  paidAt     DateTime?
  updatedAt  DateTime         @updatedAt

  @@index([centerId])
  @@index([centerId, teacherId])
  @@index([sessionId])
}

/**
 * A center's holiday calendar (docs/02-architecture.md §11): a date the
 * session generator skips when materializing `Session` rows from a
 * `ClassSchedule`. Deliberately just a date + label — not a recurring rule —
 * so a center adds "Eid al-Fitr, 2026-03-20" once and every class's window
 * skips it, without touching the schedule itself.
 */
model Holiday {
  id        String   @id @default(uuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  date      DateTime
  name      String?
  createdAt DateTime @default(now())

  @@unique([centerId, date])
  @@index([centerId])
}

// ─────────────────────────────────────────────────────────────
// EXPENSES
// ─────────────────────────────────────────────────────────────

model ExpenseCategory {
  id        String   @id @default(uuid())
  centerId  String
  center    Center   @relation(fields: [centerId], references: [id], onDelete: Cascade)
  name      String
  // Deactivates rather than hard-deletes while expenses still reference it —
  // the same convention as the other master-data entities (docs/01 §6).
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  expenses Expense[]

  @@index([centerId])
}

model Expense {
  id         String           @id @default(uuid())
  centerId   String
  center     Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  categoryId String?
  category   ExpenseCategory? @relation(fields: [categoryId], references: [id])
  amount     Int // piastres
  date       DateTime
  note       String?
  recordedBy String
  createdAt  DateTime         @default(now())

  @@index([centerId])
  @@index([centerId, date])
}

// ─────────────────────────────────────────────────────────────
// WORKFLOW
// ─────────────────────────────────────────────────────────────

model Reservation {
  id           String            @id @default(uuid())
  centerId     String
  center       Center            @relation(fields: [centerId], references: [id], onDelete: Cascade)
  classGroupId String
  classGroup   ClassGroup        @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  studentId    String
  student      User              @relation(fields: [studentId], references: [id])
  status       ReservationStatus @default(PENDING)
  requestedAt  DateTime          @default(now())
  resolvedAt   DateTime?
  resolvedBy   String?

  @@unique([classGroupId, studentId])
  @@index([centerId])
}

model ChangeRequest {
  id          String              @id @default(uuid())
  centerId    String
  center      Center              @relation(fields: [centerId], references: [id], onDelete: Cascade)
  type        ChangeRequestType
  requestedBy String // teacher userId
  payload     Json // proposed class/session details
  status      ChangeRequestStatus @default(PENDING)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())

  @@index([centerId])
}

// ─────────────────────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  centerId    String?
  center      Center?  @relation(fields: [centerId], references: [id])
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String // "payment.void", "attendance.correct", "share.change"…
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([centerId])
  @@index([entityType, entityId])
}
