# ── Database (Supabase Postgres) ─────────────────────────────
# IMPORTANT: use the **pooler** hostnames, not `db.[ref].supabase.co`.
# Supabase's direct host is IPv6-only unless you buy the IPv4 add-on, so on most
# networks (and on Vercel) it fails with "Can't reach database server".
# Copy both strings from: Supabase dashboard → Connect → ORMs → Prisma.
# Note the username is `postgres.[ref]`, and the region in the hostname must
# match your project's region.
#
# Transaction pooler — used at runtime. `connection_limit`/`pool_timeout` keep
# Prisma's client-side pool big enough that a loader's Promise.all-parallelized
# queries actually run concurrently instead of queuing behind Prisma's default
# (CPU-count-derived) pool size (docs/02-architecture.md §14).
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
# Session pooler — used for migrations.
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ── Supabase Auth / Storage ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"   # server-only, never expose to client

# ── App ──────────────────────────────────────────────────────
# The real origin per environment (production: the domain, OD-1). Used for the
# email-confirmation redirect; invite links take the browser's own origin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Default locale is set in code (lib/i18n/routing.ts), not via env.
#
# Every variable the code reads — where, required or not, server-only or
# public — is listed in docs/02-architecture.md §16 (SYS). Rule of thumb:
# NEXT_PUBLIC_* values are inlined into the browser bundle; nothing secret
# may ever carry that prefix.

# ── Auth posture (SEC-2a, D-01) ──────────────────────────────
# "true" makes every email-based link (an invitation, staff linking an existing
# account) require Supabase's email_confirmed_at, checked on the server.
# false on dev while Supabase "Confirm email" is off (no domain yet).
# MUST be "true" in production — together with Supabase Authentication → Email
# → "Confirm email" turned on. A production deployment (VERCEL_ENV=production,
# or KAYEDU_ENV=production elsewhere) refuses to start otherwise
# (instrumentation.ts → lib/auth/production-guard.ts).
REQUIRE_EMAIL_CONFIRMATION="false"
# DEMO ONLY (DEPLOY-1): "yes" lets a production deployment start while Supabase
# "Confirm email" is OFF. Loud start-up warning; ignored if
# REQUIRE_EMAIL_CONFIRMATION="true". Never set it for a real centre (M20 removes it).
# ALLOW_AUTO_CONFIRM_DEMO="yes"
# DEMO ONLY (F2): "yes" lets Account settings change a person's email WITHOUT a
# confirmation link (admin API, marked confirmed) until SMTP exists. Off, the
# email field is read-only. Ignored if REQUIRE_EMAIL_CONFIRMATION="true", and a
# production start-up refuses that combination. Remove before a real centre (M20).
# ALLOW_UNVERIFIED_EMAIL_CHANGE="yes"
# Production marker for a deployment NOT on Vercel (Vercel sets VERCEL_ENV
# itself). With either set to "production" the start-up guard above applies,
# and the seed and the dev wipe refuse to run.
# KAYEDU_ENV="production"

# ── Diagnostics (dev only) ───────────────────────────────────
# "1" logs every SQL statement Prisma runs — what `npm run perf:queries`
# counts per page request (SYS). Never set in production.
# KAYEDU_QUERY_LOG="1"
# KAYEDU_DB_STATS="1"   # dev only: per-statement ms + per-request summary (npm run perf:db)

# ── Seed (npm run db:seed) ───────────────────────────────────
# The demo seed creates its ~23 sign-in accounts (all @example.com, listed in
# docs/dev-accounts.md) through the Supabase admin API. Every one of them uses
# this password (except the platform admin, below): required, at least 6 characters, no default, never printed.
SEED_PASSWORD="[at-least-6-characters]"
# The platform admin's password (D-21): required, at least 6 characters, and
# different from SEED_PASSWORD — a tester given a demo login never holds it.
SEED_ADMIN_PASSWORD="[a-different-6-plus-characters]"
# The email domain of every seed account (default example.com). Change it only if
# `npm run seed:preflight` reports that Supabase refuses the default; then run
# `npm run seed:docs` to regenerate docs/dev-accounts.md.
# SEED_EMAIL_DOMAIN="example.com"
# The Supabase project ref of YOUR DEV project. The seed and the dev wipe
# refuse to run unless DATABASE_URL points at exactly this project.
DEV_PROJECT_REF="[dev-project-ref]"
# The dev wipe (npm run db:wipe-dev) additionally needs ALLOW_DEV_WIPE=yes in
# the environment of that one command — never put it in this file.

# ── End-to-end suite (npm run e2e, SYS) ──────────────────────
# Signs in as the seed accounts with SEED_PASSWORD / SEED_ADMIN_PASSWORD above
# against the seeded dev database. By default it starts `npm run dev` on
# E2E_PORT (3000); set E2E_BASE_URL to test an already running server.
# E2E_BASE_URL="http://localhost:3000"
# E2E_PORT="3000"
# E2E_WORKERS="2"
