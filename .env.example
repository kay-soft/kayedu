# ── Database (Supabase Postgres) ─────────────────────────────
# IMPORTANT: use the **pooler** hostnames, not `db.[ref].supabase.co`.
# Supabase's direct host is IPv6-only unless you buy the IPv4 add-on, so on most
# networks (and on Vercel) it fails with "Can't reach database server".
# Copy both strings from: Supabase dashboard → Connect → ORMs → Prisma.
# Note the username is `postgres.[ref]`, and the region in the hostname must
# match your project's region.
#
# Transaction pooler — used at runtime. `connection_limit`/`pool_timeout` keep
# Prisma's client-side pool big enough that a loader's Promise.all-parallelized
# queries actually run concurrently instead of queuing behind Prisma's default
# (CPU-count-derived) pool size (docs/02-architecture.md §14).
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
# Session pooler — used for migrations.
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ── Supabase Auth / Storage ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"   # server-only, never expose to client

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Default locale is set in code (lib/i18n/routing.ts), not via env.

# ── Seed (npm run db:seed) ───────────────────────────────────
# With SUPABASE_SERVICE_ROLE_KEY set, the seed also creates the Supabase Auth
# user so the owner can sign in straight away. Development credential only.
SEED_OWNER_EMAIL="owner@kayedu.test"
SEED_OWNER_PASSWORD="KayEdu!Dev123"
