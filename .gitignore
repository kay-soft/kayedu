# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets.
# .env.example IS committed: it documents required keys with placeholder values.
.env
.env.*
!.env.example
!.env.staging.example

# vercel
.vercel

# supabase (local CLI stack — schema/migrations live in prisma/ and are committed)
.supabase/
supabase/.branches
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# AI tool scaffolding (machine-local; not shared)
.cursor/
.devin/
.agents/
.windsurf/
.aider*
.continue/

# Claude Code: local machine settings are ignored, but .claude/skills and
# .claude/settings.json ARE committed so the team shares them.
.claude/settings.local.json
.claude/local/

# NOTE: prisma/migrations is intentionally NOT ignored — migrations are source code.
# Playwright CLI output (may contain credentials)
.playwright-cli/

# DES design review: per-role sign-in sessions and screenshots (never committed)
design-review/

# Playwright e2e (SYS): saved sign-in sessions, results, reports, traces
e2e/.auth/
e2e/.results/
e2e/.report/
