# ── KayEdu STAGING environment (S1) ───────────────────────────
# Copy to `.env.staging` (git-ignored) and fill in the values of your STAGING
# Supabase project — never the dev project, never production. Used when
# KAYEDU_ENV=staging: the seed, the wipe, seed:verify, every check:* gate and
# `npm run e2e` read THIS file instead of `.env`, and refuse to start if a
# value here points at the same project as `.env`. Full steps: docs/staging.md.
#
# Every key `.env` defines that this file does not is blanked for a staging run,
# so nothing leaks in from dev. The keys below marked (required) must be filled
# or the run stops before it connects.

# (required) Staging project, pooler hostnames — see .env.example for the shape.
DATABASE_URL=postgresql://postgres.STAGING_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20
# (required) Session pooler — used by `npm run db:deploy:staging`.
DIRECT_URL=postgresql://postgres.STAGING_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# (required)
NEXT_PUBLIC_SUPABASE_URL=https://STAGING_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# (required) Where the e2e suite's dev server runs, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# (required) The STAGING project's own ref: the seed and the wipe refuse to run
# unless DATABASE_URL points at exactly this project. (The name is historical.)
DEV_PROJECT_REF=STAGING_REF
# (required) The seed accounts' passwords; e2e signs in with them. At least 6
# characters; SEED_ADMIN_PASSWORD must differ from SEED_PASSWORD.
SEED_PASSWORD=
SEED_ADMIN_PASSWORD=

# Auth posture. The staging project needs "Confirm email" OFF in the Supabase
# dashboard (docs/staging.md §1) — then keep this false. Never "yes" on a
# project that holds real people.
REQUIRE_EMAIL_CONFIRMATION=false
# Only if the e2e dev server is started with the production marker; not needed locally.
# ALLOW_AUTO_CONFIRM_DEMO=yes

# Media switches (server only, default off) — see .env.example.
# MEDIA_UPLOADS_ENABLED=true

# Do NOT put ALLOW_DEV_WIPE here — set it for the one wipe command (docs/staging.md §7).
# KAYEDU_ENV is set in the shell (or by `npm run db:deploy:staging`), not in this file.
